{
  "manifest_version": 3,
  "name": "Tether",
  "version": "0.1.0",
  "description": "Capture tasks from any page into Tether on this PC.",
  "key": "",
  "minimum_chrome_version": "120",
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Tether" },
  "permissions": ["contextMenus", "activeTab", "scripting", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "icons": { "32": "icon-32.png", "128": "icon-128.png" }
}
